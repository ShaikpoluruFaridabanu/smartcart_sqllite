# Copy this file to .env for local development and replace placeholders.
# Never commit .env or put real credentials in source code.
SMARTCART_SECRET_KEY=generate-a-long-random-secret

# SQLite is used by default. Keep the database file outside Git.
SQLITE_DB_PATH=smartcart.db

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-new-gmail-app-password

RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret
